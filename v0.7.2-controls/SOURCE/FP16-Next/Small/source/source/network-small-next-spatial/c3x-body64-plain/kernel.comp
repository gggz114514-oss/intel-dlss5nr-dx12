// c3x_body_c64.comp — R07 dispatch B (C64): expand + act + mid reading the
// blended X from the canonical io_at layout-0 copy (binding 2, resource 248)
// instead of rebuilding it in every head slice.
//
// Differences from the fused kernel f3in_c64_owner_only_v1:
//   * no projection, no blend, no shared nr3_x / nr3_proj (saves 8,192 B);
//   * with T3d direction B the expand loads MAT_A from the canonical io_at
//     layout-0 copy (binding 2, resource 248) with row stride 16 halves; the
//     values, the K order and the OOB guard are unchanged;
//   * the debug view, expand, mid, epilogue and stores are untouched.
// Grid 42×24×2.  Shared: shA 8,192 half = 16,384 B.
#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#include "nb05_swin_c64_common.glsl"

layout(set = 0, binding = 5) buffer MBuf { float16_t gM[]; };

shared float16_t shA[8192];      // [64][128]

#define MAT_H coopmat<float16_t, gl_ScopeSubgroup, 8, 16, gl_MatrixUseAccumulator>

layout(set = 0, binding = 8) buffer Nr3Pack { float16_t pw[]; };
layout(set = 0, binding = 9) buffer Nr3Skip { float16_t sk[]; };
layout(set = 0, binding = 10) buffer Nr3BlendOut { float16_t blout[]; };
layout(set = 0, binding = 11) buffer Nr3ProjIn { float16_t x65[]; };
// Retained descriptor only: the plan keeps 13 bindings and resource 484 is
// still allocated for this pass, but the tiled staging is no longer read here.
layout(set = 0, binding = 12) buffer C3X { float16_t xg[]; };

void main() {
    const uint t_local = gl_LocalInvocationID.x;
    const uint sg = t_local / 32u;
    const uint lane = t_local % 32u;
    const uint wx = (pc.p1.z != 0) ? uint(pc.p2.x) : gl_WorkGroupID.x;
    const uint wy = (pc.p1.z != 0) ? uint(pc.p2.y) : gl_WorkGroupID.y;
    const uint g = gl_WorkGroupID.z;
    const uint w = wy * uint(pc.p1.x) + wx;
    const bool debug = pc.p1.w != 0;

    // Debug retains the original canonical X half view. No shared publication.
    if (debug && g == 0u) {
        for (uint e = t_local; e < 4096u; e += 256u) {
            bool oob;
            uint addr = c64_img_half_index(e / 64u, e % 64u, wx, wy, oob);
            dbg[e] = oob ? float16_t(0.0) : imgin[addr];
        }
    }

    // ---- expand: per pair A(X rows) from the global canonical X ----
    const uint we = uint(pc.p3.x);
    // A05: keep both r owners live; each ki weight fragment serves all four M8 blocks.
    {
        uint n0 = (sg % 4u) * 32u;
        uint mA_r0 = (sg / 4u + 4u * 0u) * 8u;
        uint mB_r0 = mA_r0 + 16u;
        // Each M8 is inside one token16 tile; OOB is uniform in this subgroup.
        // Canonical layout: within a 16-token tile tokens are 16 halves apart, so an
        // M8 x K16 fragment is one contiguous 256-byte run and each K16 step is +256.
        bool oobA_r0, oobB_r0;
        uint xA_r0 = c64_img_half_index(mA_r0, 0u, wx, wy, oobA_r0);
        uint xB_r0 = c64_img_half_index(mB_r0, 0u, wx, wy, oobB_r0);
        MAT_C accA0_r0 = MAT_C(float16_t(0.0));
        MAT_C accA1_r0 = MAT_C(float16_t(0.0));
        MAT_C accB0_r0 = MAT_C(float16_t(0.0));
        MAT_C accB1_r0 = MAT_C(float16_t(0.0));
        uint mA_r1 = (sg / 4u + 4u * 1u) * 8u;
        uint mB_r1 = mA_r1 + 16u;
        // Each M8 is inside one token16 tile; OOB is uniform in this subgroup.
        // Canonical layout: within a 16-token tile tokens are 16 halves apart, so an
        // M8 x K16 fragment is one contiguous 256-byte run and each K16 step is +256.
        bool oobA_r1, oobB_r1;
        uint xA_r1 = c64_img_half_index(mA_r1, 0u, wx, wy, oobA_r1);
        uint xB_r1 = c64_img_half_index(mB_r1, 0u, wx, wy, oobB_r1);
        MAT_C accA0_r1 = MAT_C(float16_t(0.0));
        MAT_C accA1_r1 = MAT_C(float16_t(0.0));
        MAT_C accB0_r1 = MAT_C(float16_t(0.0));
        MAT_C accB1_r1 = MAT_C(float16_t(0.0));
        for (uint ki = 0u; ki < 4u; ++ki) {
            MAT_B wb0; coopMatLoad(wb0, pack, we + ((128u * g + n0) / 16u) * 1024u + ki * 256u, 16u, LCOL);
            MAT_B wb1; coopMatLoad(wb1, pack, we + ((128u * g + n0 + 16u) / 16u) * 1024u + ki * 256u, 16u, LCOL);
            {
            MAT_A a = MAT_A(float16_t(0.0));
            if (!oobA_r0) coopMatLoad(a, imgin, xA_r0 + 256u * ki, 16u, LROW);
            accA0_r0 = coopMatMulAdd(a, wb0, accA0_r0);
            accA1_r0 = coopMatMulAdd(a, wb1, accA1_r0);
            a = MAT_A(float16_t(0.0));
            if (!oobB_r0) coopMatLoad(a, imgin, xB_r0 + 256u * ki, 16u, LROW);
            accB0_r0 = coopMatMulAdd(a, wb0, accB0_r0);
            accB1_r0 = coopMatMulAdd(a, wb1, accB1_r0);
            }
            {
            MAT_A a = MAT_A(float16_t(0.0));
            if (!oobA_r1) coopMatLoad(a, imgin, xA_r1 + 256u * ki, 16u, LROW);
            accA0_r1 = coopMatMulAdd(a, wb0, accA0_r1);
            accA1_r1 = coopMatMulAdd(a, wb1, accA1_r1);
            a = MAT_A(float16_t(0.0));
            if (!oobB_r1) coopMatLoad(a, imgin, xB_r1 + 256u * ki, 16u, LROW);
            accB0_r1 = coopMatMulAdd(a, wb0, accB0_r1);
            accB1_r1 = coopMatMulAdd(a, wb1, accB1_r1);
            }
        }
        {
            MAT_H values = MAT_H(accA0_r0);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mA_r0) * 256u + 128u * g + n0 + 0u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mA_r0/8u)*8u+n0/16u+0u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mA_r0) * 256u + 128u * g + n0 + 0u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accA1_r0);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mA_r0) * 256u + 128u * g + n0 + 16u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mA_r0/8u)*8u+n0/16u+1u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mA_r0) * 256u + 128u * g + n0 + 16u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accB0_r0);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mB_r0) * 256u + 128u * g + n0 + 0u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mB_r0/8u)*8u+n0/16u+0u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mB_r0) * 256u + 128u * g + n0 + 0u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accB1_r0);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mB_r0) * 256u + 128u * g + n0 + 16u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mB_r0/8u)*8u+n0/16u+1u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mB_r0) * 256u + 128u * g + n0 + 16u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accA0_r1);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mA_r1) * 256u + 128u * g + n0 + 0u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mA_r1/8u)*8u+n0/16u+0u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mA_r1) * 256u + 128u * g + n0 + 0u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accA1_r1);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mA_r1) * 256u + 128u * g + n0 + 16u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mA_r1/8u)*8u+n0/16u+1u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mA_r1) * 256u + 128u * g + n0 + 16u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accB0_r1);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mB_r1) * 256u + 128u * g + n0 + 0u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mB_r1/8u)*8u+n0/16u+0u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mB_r1) * 256u + 128u * g + n0 + 0u, 256u, LROW);
        }
        {
            MAT_H values = MAT_H(accB1_r1);
            if (debug)
                coopMatStore(values, dbg, 4096u + (mB_r1) * 256u + 128u * g + n0 + 16u, 256u, LROW);
            for (int ci = 0; ci < values.length(); ++ci)
                values[ci] = c64_act_h(values[ci]);
            coopMatStore(values, shA, ((mB_r1/8u)*8u+n0/16u+1u)*128u, 16u, LROW);
            if (debug)
                coopMatStore(values, dbg, 20480u + (mB_r1) * 256u + 128u * g + n0 + 16u, 256u, LROW);
        }
    }
    barrier();   // expand complete for all SGs; A visible

    // ---- act already applied in epilogue (A lives in shA) ----

    // ---- mid 64×32×128: Nc=2, Np=1; m0=8*sg, n0=0/16; output -> global M ----
    const uint wm = uint(pc.p3.y);
     {
        const uint m0 = (sg / 2u) * 16u;
        const uint nc = 32u * g + (sg % 2u) * 16u;
        MAT_C acc0 = MAT_C(float16_t(0.0));
        MAT_C acc1 = MAT_C(float16_t(0.0));
        for (uint ki = 0u; ki < 8u; ++ki) {
            const uint k0 = ki * 16u;
            MAT_B b; coopMatLoad(b, pack, wm + nc * 128u + k0, 128u, LCOL);
            MAT_A a;
            coopMatLoad(a, shA, ((m0 / 8u) * 8u + ki) * 128u, 16u, LROW);
            acc0 = coopMatMulAdd(a, b, acc0);
            coopMatLoad(a, shA, (((m0 + 8u) / 8u) * 8u + ki) * 128u, 16u, LROW);
            acc1 = coopMatMulAdd(a, b, acc1);
        }
        MAT_H narrowed = MAT_H(acc0);
        coopMatStore(narrowed, gM, (w * 64u + m0) * 64u + nc, 64u, LROW);
        if (debug)
            coopMatStore(narrowed, dbg, 36864u + (m0) * 64u + nc, 64u, LROW);
        narrowed = MAT_H(acc1);
        coopMatStore(narrowed, gM, (w * 64u + m0 + 8u) * 64u + nc, 64u, LROW);
        if (debug)
            coopMatStore(narrowed, dbg, 36864u + (m0 + 8u) * 64u + nc, 64u, LROW);
    }
}
