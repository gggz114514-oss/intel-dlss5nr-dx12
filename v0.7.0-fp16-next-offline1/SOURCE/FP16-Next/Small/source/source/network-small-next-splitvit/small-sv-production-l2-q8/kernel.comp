// S22 REGISTER-P, transposed four-query-owner attention (ZCode C unit 5, 2026-10-20).
//
// Parent: candidates/dhs-netorg-long-20261018/T1/s22-stage-addr-hoist-v1/source/
//         split16_attention_opt_exec_fp16.comp (SHA f97f9936..., deployed SPV
//         0fa5e5b4...).  That parent recompiles byte-for-byte with glslang 16.5.0.
//
// WHAT CHANGES (deployed lines 197-334 only)
//   The parent keeps P in phase[4096] because score is [query][key] (8 queries x
//   64 keys split across an SG pair) while PV needs P^T as B.  Here the four
//   query-block owners (SG 0..3, 16 queries each) compute S^T = K.Q^T, so
//     * key 16j+c / 16j+c+8 pairing is in-lane (same lane, same component);
//     * P^T is the B operand through the B580-proven nrh_join_rows_to_B;
//     * V^T (physical dim*64+key) is A with ROW64 and four FP32 accumulators
//       hold dim blocks 0..7,8..15,16..23,24..31 for 16 queries;
//     * the result is stored COL stride 16 to the canonical gt address.
//
// WHAT IS PRESERVED EXACTLY
//   * QKV projection (six accumulators, 32 K16 steps), input staging, address
//     hoist, V physical layout, all three barriers 121/145/154 and the debug echo;
//   * norm owner (ROW_OWNER=1): 32 squares, 31-add half tree, half max/rsqrt,
//     Q=H(H(Q*nq)*scale), K=H(K*nk), barrier 196;
//   * score K order: every (query,key) gets dim 0..15 then 16..31, one FP32
//     accumulator chain per output, precise FP32 bias add, one half narrowing,
//     M05 paired exp applied element-wise;
//   * sealed den tree, node for node: explicit +0, t_j=P[16j+c]+P[16j+c+8],
//     part[c]=((0+t0)+t1)+t2)+t3, even=(part0+part2)+(part4+part6),
//     odd=(part1+part3)+(part5+part7), total=even+odd, inv=H(1.0f/max(float,2^-14)),
//     P:=H(P*inv) one rounding point;
//   * PV key order 0..15,16..31,32..47,48..63 and the canonical gt address
//     gt[tiled(token,h*32+dim,512)] = base + q*16 + dim%16.
//
// NOT CHANGED: bindings, push constants, local_size 256, phase/qkv shared
// allocation (20480 B), QKV/norm debug echoes, necessary T clear (runner-side).
//
// N10-F10 (2026-10-27) kc A-feed address and slice lifetime.  Two hunks, both in
// the QKV kc loop, both integer/address only:
//   (1) the four staging bases are linear in kc, so they are built once and
//       advanced by 1024 halves per slice instead of recomputed by tiled();
//   (2) the staged 64x64 slice is consumed jointly by both M blocks of every SG
//       (a0 = rows mA..mA+7, a1 = rows mB..mB+7) and by both SGs of an SG pair,
//       so it needs one publish barrier, not publish+retire: the two arrays are
//       one arena and the slice window alternates between the halves, so the next
//       slice publish retires the previous slice.
// Unchanged: staged bytes, load/store counts, A fragments, the three independent
// weight return regions and the weight read count, DPAS order, every floating
// expression, shared 20480 B, grid, lane activity.
#version 450

#ifndef NR_PRODUCTION
#define NR_PRODUCTION 0
#endif
#if NR_PRODUCTION
#define NR_PRODUCTION_DEBUG(v) false
#else
#define NR_PRODUCTION_DEBUG(v) (v)
#endif
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
layout(local_size_x=256) in;
#include "split16_common.glsl"
#include "register_handoff.glsl"
#ifndef ROW_OWNER
#define ROW_OWNER 1
#endif
// R07: C02 loads A directly from gy; its former staging prefix is unused.
// The 12 KiB arena holds Q [0,2048), K [2048,4096), V [4096,6144).
// Raw QKV debug uses the same QKV_OFF-relative layout.
shared float16_t smem[6144];
#define QKV_OFF 0u
#define sp smem
#if !ROW_OWNER
shared float16_t sn[256]; // Only the ticket's A_ONLY attribution path.
#endif
// PV uses the retired Q prefix as its standard half bridge; P stays live.
// Q[0..1024) is dead after the score WG barrier, V remains at [4096..6144).
uint v_raw(uint e) { return e<4096u ? e : 4096u+((e-4096u)%32u)*64u+(e-4096u)/32u; }
uint wq_tile(uint r,uint k) { return uint(pc.p3.y)+((r/16u)*32u+k/16u)*256u; }
#define QBUF smem
#define KBUF smem
#define VBUF smem
#define QBASE 0u
#define KBASE 2048u
#define VBASE 4096u
#define Q(E) smem[QKV_OFF+QBASE+(E)]
#define K(E) smem[QKV_OFF+KBASE+(E)]
#define CH coopmat<float16_t,gl_ScopeSubgroup,8,16,gl_MatrixUseAccumulator>
// One 8-key x 16-query block of S^T = K.Q^T for the owner's 16 queries.
// KB is the key base (multiple of 8); OUT receives the half probability block.
// Uses qg,w,h,bq0,bq1 from the enclosing owner scope, in the same style as the
// deployed SCORE_SIDE macro.  Inlined eight times so no cooperative matrix is
// passed across a function boundary.
#define S22_SCORE_BLOCK(KB,OUT) { \
    NRH_C acc=NRH_C(0.0); \
    { \
        NRH_A a; \
        coopMatLoad(a,smem,QKV_OFF+KBASE+(KB)*32u,32u,ROW); \
        acc=coopMatMulAdd(a,bq0,acc); \
    } \
    { \
        NRH_A a; \
        coopMatLoad(a,smem,QKV_OFF+KBASE+(KB)*32u+16u,32u,ROW); \
        acc=coopMatMulAdd(a,bq1,acc); \
    } \
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) coopMatStore(acc,dbg,ldbg(0u,w,h,qg*64u+(KB)),64u,COL); \
    { \
        NRH_C bias; \
        coopMatLoad(bias,aux,uint(pc.p4.x)+h*4096u+qg*64u+(KB),64u,COL); \
        for(uint c=0u;c<acc.length();c++) { \
            precise float biased=acc[c]+bias[c]; \
            acc[c]=biased; \
        } \
    } \
    NRH_CH narrowed=NRH_CH(acc); \
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) { \
        NRH_C wide=nrh_widen_exact(narrowed); \
        coopMatStore(wide,dbg,ldbg(1u,w,h,qg*64u+(KB)),64u,COL); \
    } \
    {f16vec2 e01=exponential2(f16vec2(narrowed[0],narrowed[1]));narrowed[0]=e01.x;narrowed[1]=e01.y; \
     f16vec2 e23=exponential2(f16vec2(narrowed[2],narrowed[3]));narrowed[2]=e23.x;narrowed[3]=e23.y;} \
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) { \
        NRH_C wide=nrh_widen_exact(narrowed); \
        coopMatStore(wide,dbg,ldbg(2u,w,h,qg*64u+(KB)),64u,COL); \
    } \
    OUT=narrowed; \
}


// Two token fragments x three N16 fragments; same-use half conversion only.
#define STORE_QKV(M,N,ACC) { \
    CH value=CH(ACC); \
    uint column=(N); \
    if(column<64u) coopMatStore(value,smem,QKV_OFF+(column/32u)*2048u+(M)*32u+column%32u,32u,ROW); \
    else coopMatStore(value,smem,QKV_OFF+4096u+(column-64u)*64u+(M),64u,COL); \
}

// Same Scope/Use/shape fixes component correspondence without a lane map.
// One bias MC and one half temporary live only for the current side.
#define SCORE_SIDE(ACC,SIDE) { \
    uint pos=m0*64u+n0+16u*(SIDE); \
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) coopMatStore(ACC,dbg,ldbg(0u,w,h,pos),64u,ROW); \
    { \
        MC bias; \
        coopMatLoad(bias,aux,uint(pc.p4.x)+h*4096u+pos,64u,ROW); \
        for(uint c=0u;c<ACC.length();c++) { \
            precise float biased=ACC[c]+bias[c]; \
            ACC[c]=biased; \
        } \
    } \
    CH narrowed=CH(ACC); \
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) { \
        coopMatStore(narrowed,sp,pos,64u,ROW); \
        subgroupMemoryBarrierShared();subgroupBarrier(); \
        for(uint e=lane;e<128u;e+=32u) { \
            uint address=pos+e/16u*64u+e%16u; \
            dbg[ldbg(1u,w,h,address)]=float(sp[address]); \
        } \
        subgroupMemoryBarrierShared();subgroupBarrier(); \
    } \
    for(uint c=0u;c<narrowed.length();c++) narrowed[c]=exponential(narrowed[c]); \
    coopMatStore(narrowed,sp,pos,64u,ROW); \
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) { \
        subgroupMemoryBarrierShared();subgroupBarrier(); \
        for(uint e=lane;e<128u;e+=32u) { \
            uint address=pos+e/16u*64u+e%16u; \
            dbg[ldbg(2u,w,h,address)]=float(sp[address]); \
        } \
    } \
}

uint qkv_a_offset(uint e) { uint r=e/64u,k=e%64u; return ((r/8u)*4u+k/16u)*128u+(k%16u)*8u+r%8u; }

f16vec4 l2_shuffle(f16vec4 x,uint lane) {
    uint xy=subgroupShuffle(packFloat2x16(x.xy),lane);
    uint zw=subgroupShuffle(packFloat2x16(x.zw),lane);
    return f16vec4(unpackFloat2x16(xy),unpackFloat2x16(zw));
}

void main() {
    uint lid=gl_LocalInvocationID.x,sg=lid/32u,lane=lid%32u;
    uint wx=gl_WorkGroupID.x,wy=gl_WorkGroupID.y,h=gl_WorkGroupID.z;
    uint w=wy*uint(pc.p1.x)+wx;
    // B580 adaptation: SG=(token pair,N48 half), 8 SG cover 64x96 exactly.
    // Every B fragment feeds two M8 products; K order and six accumulators stay fixed.
    {
        uint mA=(sg/2u)*16u,mB=mA+8u,n0=(sg%2u)*48u;
        MC acc00=MC(0.0);
        MC acc01=MC(0.0);
        MC acc02=MC(0.0);
        MC acc10=MC(0.0);
        MC acc11=MC(0.0);
        MC acc12=MC(0.0);
        // C02: same FP16 gy A values, directly loaded by both N48 SG owners.
        bool a_valid;
        uint a_token=window_token(wx,wy,mA,a_valid);
        uint a_base=a_valid?tiled(a_token,0u,512u):0u;
        if(a_valid)
        for(uint kc=0u;kc<512u;kc+=64u) {
            for(uint k=0u;k<64u;k+=16u) {
                MA a0=MA(0.0),a1=MA(0.0);
                coopMatLoad(a0,gy,a_base+((kc+k)/16u)*256u,16u,ROW);
                coopMatLoad(a1,gy,a_base+((kc+k)/16u)*256u+128u,16u,ROW);
                MB b0,b1,b2;
                coopMatLoad(b0,weights,wq_tile(h*96u+n0+0u,kc+k),16u,COL);
                coopMatLoad(b1,weights,wq_tile(h*96u+n0+16u,kc+k),16u,COL);
                coopMatLoad(b2,weights,wq_tile(h*96u+n0+32u,kc+k),16u,COL);
                acc00=coopMatMulAdd(a0,b0,acc00);
                acc10=coopMatMulAdd(a1,b0,acc10);
                acc01=coopMatMulAdd(a0,b1,acc01);
                acc11=coopMatMulAdd(a1,b1,acc11);
                acc02=coopMatMulAdd(a0,b2,acc02);
                acc12=coopMatMulAdd(a1,b2,acc12);
            }
        }
        STORE_QKV(mA,n0+0u,acc00)
        STORE_QKV(mA,n0+16u,acc01)
        STORE_QKV(mA,n0+32u,acc02)
        STORE_QKV(mB,n0+0u,acc10)
        STORE_QKV(mB,n0+16u,acc11)
        STORE_QKV(mB,n0+32u,acc12)
    }
    barrier();
    if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {
        for(uint e=lid;e<6144u;e+=256u)
            dbg[qdbg(e/2048u,w,h,e%2048u)]=float(smem[QKV_OFF+v_raw(e)]);
        // All raw debug readers finish before row owners overwrite Q/K.
        barrier();
    }
#if ROW_OWNER
    {
        float16_t scale=float16_t(aux[uint(pc.p4.y)+h]);
        if(lid<64u) {
            float16_t qr[32],kr[32];
            for(uint c=0u;c<32u;c++) {qr[c]=Q(lid*32u+c);kr[c]=K(lid*32u+c);}
            float16_t nq=float16_t(inversesqrt(max(norm32(qr),float(float16_t(0.000062)))));
            float16_t nk=float16_t(inversesqrt(max(norm32(kr),float(float16_t(0.000062)))));
            for(uint c=0u;c<32u;c++) {
                uint e=lid*32u+c;
                precise float16_t qn=qr[c]*nq;
                precise float16_t qs=qn*scale;
                precise float16_t kn=kr[c]*nk;
                Q(e)=qs;K(e)=kn;
                if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {dbg[qdbg(3u,w,h,e)]=float(qs);dbg[qdbg(4u,w,h,e)]=float(kn);}
            }
        }
    }
#else
    if(lid<64u) {
        float16_t qr[32],kr[32];
        for(uint c=0u;c<32u;c++) {qr[c]=Q(lid*32u+c);kr[c]=K(lid*32u+c);}
        sn[lid]=float16_t(inversesqrt(max(norm32(qr),float(float16_t(0.000062)))));
        sn[64u+lid]=float16_t(inversesqrt(max(norm32(kr),float(float16_t(0.000062)))));
    }
    barrier();
    float16_t scale=float16_t(aux[uint(pc.p4.y)+h]);
    for(uint e=lid;e<2048u;e+=256u) {
        precise float16_t qn=Q(e)*sn[e/32u];
        precise float16_t qs=qn*scale;
        precise float16_t kn=K(e)*sn[64u+e/32u];
        Q(e)=qs;K(e)=kn;
        if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {dbg[qdbg(3u,w,h,e)]=float(qs);dbg[qdbg(4u,w,h,e)]=float(kn);}
    }
#endif
    barrier();

    // Eight query owners, each retaining a complete four-block K sequence.
    {
        uint qg=sg*8u;
        bool valid;
        uint tile=window_token(wx,wy,qg,valid);
        if(valid || NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {
        NRH_A aq0,aq1;
        coopMatLoad(aq0,smem,QKV_OFF+QBASE+qg*32u,32u,ROW);
        coopMatLoad(aq1,smem,QKV_OFF+QBASE+qg*32u+16u,32u,ROW);
        NRH_CH p[4];
        precise f16vec4 part=f16vec4(float16_t(0.0));
        for(uint j=0u;j<4u;++j) {
            uint kb=j*16u;
            NRH_B bk0,bk1;
            coopMatLoad(bk0,smem,QKV_OFF+KBASE+kb*32u,32u,COL);
            coopMatLoad(bk1,smem,QKV_OFF+KBASE+kb*32u+16u,32u,COL);
            NRH_C score=NRH_C(0.0);
            score=coopMatMulAdd(aq0,bk0,score);
            score=coopMatMulAdd(aq1,bk1,score);
            uint pos=qg*64u+kb;
            if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) coopMatStore(score,dbg,ldbg(0u,w,h,pos),64u,ROW);
            NRH_C bias;
            coopMatLoad(bias,aux,uint(pc.p4.x)+h*4096u+pos,64u,ROW);
            for(uint ci=0u;ci<score.length();++ci) {
                precise float biased=score[ci]+bias[ci];
                score[ci]=biased;
            }
            NRH_CH narrowed=NRH_CH(score);
            if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {
                NRH_C wide=nrh_widen_exact(narrowed);
                coopMatStore(wide,dbg,ldbg(1u,w,h,pos),64u,ROW);
            }
            f16vec2 p01=exponential2(f16vec2(narrowed[0],narrowed[1]));
            f16vec2 p23=exponential2(f16vec2(narrowed[2],narrowed[3]));
            narrowed[0]=p01.x;narrowed[1]=p01.y;
            narrowed[2]=p23.x;narrowed[3]=p23.y;
            if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {
                NRH_C wide=nrh_widen_exact(narrowed);
                coopMatStore(wide,dbg,ldbg(2u,w,h,pos),64u,ROW);
            }
            p[j]=narrowed;
            f16vec4 value=f16vec4(p01,p23);
            f16vec4 peer=l2_shuffle(value,lane^8u);
            precise f16vec4 pair=(lane&8u)==0u?value+peer:peer+value;
            part=part+pair;
        }
        // L2's balanced even/odd tree and explicit initial zero are retained.
        precise f16vec4 two=l2_shuffle(part,lane^2u);
        precise f16vec4 four=l2_shuffle(part,lane^4u);
        precise f16vec4 six=l2_shuffle(part,lane^6u);
        precise f16vec4 low=part+two,high=four+six;
        precise f16vec4 parity=low+high;
        precise f16vec4 peer=l2_shuffle(parity,lane^1u);
        precise f16vec4 total=parity+peer;
        f16vec4 den=l2_shuffle(total,lane&16u);
        f16vec4 inv;
        for(uint ci=0u;ci<4u;++ci)
            inv[ci]=float16_t(1.0/max(float(den[ci]),6.103515625e-05));
        NRH_C c0=NRH_C(0.0),c1=NRH_C(0.0);
        for(uint j=0u;j<4u;++j) {
            uint kb=j*16u;
            NRH_CH probabilities=p[j];
            for(uint ci=0u;ci<probabilities.length();++ci)
                probabilities[ci]=float16_t(probabilities[ci]*inv[ci]);
            if(NR_PRODUCTION_DEBUG(pc.p5.x!=0)) {
                NRH_C wide=nrh_widen_exact(probabilities);
                coopMatStore(wide,dbg,ldbg(3u,w,h,qg*64u+kb),64u,ROW);
            }
            NRH_A probability=nrh_to_A(probabilities);
            NRH_B v0,v1;
            coopMatLoad(v0,smem,QKV_OFF+VBASE+kb,64u,COL);
            c0=coopMatMulAdd(probability,v0,c0);
            coopMatLoad(v1,smem,QKV_OFF+VBASE+16u*64u+kb,64u,COL);
            c1=coopMatMulAdd(probability,v1,c1);
        }
        if(valid) {
            uint base=(tile/16u)*32u+2u*h;
            uint row=(tile%16u)*16u;
            coopMatStore(NRH_CH(c0),gt,(base+0u)*256u+row,16u,ROW);
            coopMatStore(NRH_CH(c1),gt,(base+1u)*256u+row,16u,ROW);
        }
        }
    }
}
